#!/bin/sh
# Blocks a push that would publish personal data. CI only runs after content is already
# public, so this is the check that matters. Installed by `npm install` (prepare script).
cd "$(git rev-parse --show-toplevel)" || exit 1
input=$(cat)
printf '%s\n' "$input" | node tools/pre-push.mjs --require-blocked-words || exit 1
node tools/pii-scan.mjs --require-blocked-words || exit 1
